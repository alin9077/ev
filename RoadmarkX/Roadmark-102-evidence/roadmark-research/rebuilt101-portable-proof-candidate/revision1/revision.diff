+        'typecheck': ['node', 'node_modules/typescript/bin/tsc', '--noEmit'],
+        'lint': ['node', 'node_modules/eslint/bin/eslint.js', 'src', 'tests', 'scripts'],
+        'validation': ['node', '--import', 'tsx', 'scripts/validate.ts'],
