{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmark-changes-v1",
  "title": "Roadmark monthly changes",
  "description": "Generated by scripts/refresh/diff.ts from two coverage snapshots. A change is exactly one of eight types; a rechecked-unchanged claim is not a change.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "month", "generator", "before", "after", "counts", "sources", "changes"],
  "properties": {
    "schema": { "const": "roadmark-changes-v1" },
    "month": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
    "generator": { "const": "scripts/refresh/diff.ts" },
    "before": { "$ref": "#/$defs/snapshotRef" },
    "after": { "$ref": "#/$defs/snapshotRef" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price_changed", "price_added", "price_removed", "version_added", "version_withdrawn", "availability_changed", "range_changed", "warranty_changed"],
      "properties": {
        "price_changed": { "type": "integer", "minimum": 0 },
        "price_added": { "type": "integer", "minimum": 0 },
        "price_removed": { "type": "integer", "minimum": 0 },
        "version_added": { "type": "integer", "minimum": 0 },
        "version_withdrawn": { "type": "integer", "minimum": 0 },
        "availability_changed": { "type": "integer", "minimum": 0 },
        "range_changed": { "type": "integer", "minimum": 0 },
        "warranty_changed": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "sha256"],
      "properties": {
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "title", "publisher", "accessed_date"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "accessed_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "value": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "unit", "basis"],
      "properties": {
        "value": { "type": ["string", "number", "null"] },
        "unit": { "type": "string" },
        "basis": { "type": "string" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "versionId", "brand", "vehicle", "family", "slug", "field", "before", "after", "beforeDate", "afterDate", "sourceIds"],
      "properties": {
        "type": { "enum": ["price_changed", "price_added", "price_removed", "version_added", "version_withdrawn", "availability_changed", "range_changed", "warranty_changed"] },
        "versionId": { "type": "string", "minLength": 1 },
        "brand": { "type": "string", "minLength": 1 },
        "vehicle": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "before": { "$ref": "#/$defs/value" },
        "after": { "$ref": "#/$defs/value" },
        "beforeDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "afterDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
